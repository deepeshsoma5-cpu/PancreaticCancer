install.packages("rms", dependencies = TRUE)
q()
install.packages("timeROC", dependencies = TRUE)
q()
install.packages("rms")

# 1. Install the remotes package if you don't have it
install.packages("remotes")

# 2. Install a version of rms compatible with R 4.3 (e.g., version 6.8-1)
remotes::install_version("rms", version = "6.8-1", repos = "https://cran.r-project.org")

# 3. Now try installing timeROC again
install.packages("timeROC")

install.packages("timeROC")

q()
